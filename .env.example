# ---- Convex (web + worker) ----
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Shared secret between the worker and every Convex mutation it calls.
# Set the SAME value in the Convex dashboard environment variables.
WORKER_TOKEN=change-me

# ---- Worker ----
# Which deployment the worker polls for queued roasts (usually the prod url).
ROAST_CONVEX_URL=https://your-deployment.convex.cloud

# Inference. Both passes use this model; the checklist pass always runs at low effort.
# ROAST_CODEX_MODEL=gpt-5.6-sol
# ROAST_CODEX_REASONING=medium

# Concurrency and pacing.
# ROAST_CONCURRENCY=3              # job slots in this process
# ROAST_CODEX_TURNS_PER_MIN=12     # token bucket shared by every slot
# ROAST_POLL_MS=4000               # idle poll interval, plus jitter

# Extras.
# ROAST_COVER_IMAGE=1              # generate a cover concept per dark roast
# ROAST_KEEP_RUNTIME=1             # keep per audit scratch files for debugging
# ROAST_FAKE_RATELIMIT=1           # force one fake 429 to test the cooldown path

# ---- Optional video pass (dark roasts, opt in per roast) ----
# ROAST_VSL=1
# GOOGLE_API_KEY=your-gemini-key
# ROAST_GEMINI_MODEL=gemini-3.8-flash
# ROAST_VSL_STORE=1                # also store the trimmed clip in Convex

# ---- Container worker only (see the Dockerfile) ----
# CODEX_HOME=/data/.codex
# CODEX_AUTH_JSON_B64=base64 of an authenticated ~/.codex/auth.json
